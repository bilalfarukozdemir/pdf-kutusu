    <!-- ================= about ================= -->
    <string name="hakkinda_baslik">About</string>
    <string name="hakkinda_uygulama_adi">PDF Box</string>
    <string name="hakkinda_surum">Version %1$s</string>
    <string name="hakkinda_yapimci_etiket">Made by</string>
    <string name="hakkinda_yapimci_govde">Tapping opens your browser. The app never sends any data.</string>
    <string name="hakkinda_risk_baslik">Low-risk use warning</string>
    <string name="hakkinda_risk_govde">This tool is for personal, low-risk use. Don\'t rely on it alone for official, legal, or regulated documents. Always open the output and check it visually.</string>
    <string name="hakkinda_izinler_baslik">Permissions</string>
    <string name="hakkinda_izinler_govde">"This app requests NO permissions at all. AndroidManifest.xml contains no INTERNET permission; network permissions that dependencies try to add are stripped out during manifest merging, and a build-time verification task checks this.\n\nFile picking and export use the Storage Access Framework (SAF), which needs no permission. MANAGE_EXTERNAL_STORAGE or broad storage access is never requested."</string>
    <string name="hakkinda_veri_baslik">Where your data lives</string>
    <string name="hakkinda_veri_govde">"• Copies of files you choose: app storage / calisma\n• Generated outputs: app storage / cikti\n• Temporary files: cache / gecici\n• Operation log: app storage / pdf_kutusu.db (SQLite)\n\nAll of it is app-private; other apps can\'t read it. Cloud backup and device transfer are disabled. Uninstalling the app deletes all of it."</string>
    <string name="hakkinda_orijinal_baslik">Your original files</string>
    <string name="hakkinda_orijinal_govde">"The source file is never written to. Every operation produces a new output file:\n\n&lt;original-name&gt;__&lt;operation&gt;__&lt;yyyyMMdd-HHmmss&gt;.pdf"</string>
    <string name="hakkinda_exif_baslik">Your images and EXIF</string>
    <string name="hakkinda_exif_govde">The Images to PDF tool decodes and re-encodes images. The EXIF data photos carry — GPS location, device make and model, capture date — is not carried over to the output. Orientation is read and applied, though, so pages don\'t end up sideways.</string>
    <string name="hakkinda_kutuphane_baslik">Libraries used</string>
    <string name="hakkinda_kutuphane_govde">"• PdfBox-Android (Apache 2.0) — PDF reading/writing\n• Android PdfRenderer (built-in) — page display and rasterization\n• ML Kit Text Recognition v2, bundled model (Apache 2.0) — on-device OCR\n• AndroidX ExifInterface (Apache 2.0) — image orientation tag\n• Jetpack Compose, Material 3, Room (Apache 2.0)\n\nNo AGPL-licensed components are used (no MuPDF, iText, etc.)."</string>
    <string name="hakkinda_yazitipi_baslik">Bundled font</string>
    <string name="hakkinda_yazitipi_govde">"Watermark text is drawn with Noto Sans (static version), bundled with the app; only the characters actually used are embedded into the PDF. This keeps letters like ğ, ş, ı rendering correctly on every device.\n\nNoto Sans — Copyright The Noto Project Authors.\nLicensed under the SIL Open Font License 1.1.\nLicense text: assets/fonts/OFL.txt"</string>
    <string name="hakkinda_bilerek_yapilmayan_baslik">Deliberately not included</string>
    <string name="hakkinda_bilerek_yapilmayan_govde">"• Office → PDF conversion: can\'t be done reliably on a mobile device. Use the Microsoft Office app for that.\n• Signature flow (inviting signers, approval records): requires a server and authentication; meaningless in an offline phone app.\n• Accounts, subscriptions, telemetry, analytics, cloud sync, ads: none.\n• Embedding a searchable OCR text layer into the PDF: out of scope for this version."</string>
