<?xml version="1.0" encoding="utf-8"?>
<!--
  Bulut yedegi ve cihaz-transferi tamamen kapali. Islenen PDF'ler ve islem
  gunlugu cihazdan disari cikmaz.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
